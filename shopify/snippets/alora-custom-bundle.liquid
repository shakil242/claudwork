<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');

.alora-bundle-wrap {
  max-width: 580px;
  margin: 0 auto;
  font-family: 'Inter', sans-serif;
  color: #000000;
}

/* ── Bundle bars ── */
.alora-bundle-options { display: flex; flex-direction: column; gap: 6px; }

.alora-bundle-bar {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 15px 18px;
  border: 2px solid #B2CCC0;
  border-radius: 16px;
  background: #fff;
  cursor: pointer;
  transition: border-color .18s, background .18s;
}
.alora-bundle-bar:hover { border: 2px solid #B2CCC0; }
.alora-bundle-bar.is-selected {
  border: 2px solid rgba(1, 85, 45, 1);
  background: #f0faf4;
}

.alora-bundle-content {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}
.alora-bundle-info { display: flex; flex-direction: column; gap: 3px; }
.alora-bundle-name {
  font-size: 18px;
  font-weight: 800;
  color: #000000;
  line-height: 1.2;
  letter-spacing:normal;
}
.alora-bundle-savings {
      font-size: 13px;
    color: #555555;
    font-weight: 500;
    font-family: Poppins, sans-serif;
    letter-spacing: normal;
}
.alora-bundle-radio {
  flex-shrink: 0;
  width: 20px; height: 20px;
  border: 3px solid #FFF;
  border-radius: 50%;
  display: flex!important; align-items: center; justify-content: center;
  transition: all .18s;
  box-shadow: 0 0 0 2px rgba(1, 85, 45, 0.3);
}
.alora-bundle-bar.is-selected .alora-bundle-radio {
  background: rgba(1, 85, 45, 1);
      box-shadow: 0 0 0 2px rgba(1, 85, 45, 1);
}
.alora-bundle-bar.is-selected .alora-bundle-radio::after {
  content: '';
  background: #fff;
  border-radius: 50%;
  display: block;
}

.alora-bundle-price-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 1px;
}
.alora-bundle-price-main {
  font-size: 16px;
  font-weight: 700;
  color: #000000;
  line-height: 1;
}
.alora-bundle-price-compare {
  font-size: 13px;
  color: #aaa;
  text-decoration: line-through;
  font-weight: 400;
}

.alora-bundle-badge {
  position: absolute;
  top: -9px;
  right: 18px;
  display: inline-block;
  margin: 0 8px;
  padding: 6px 8px;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;
  font-family: sans-serif;
  font-size: 12px;
  font-weight: 700;
  line-height: 1;
  color: #fff;
  background-color: rgba(1, 85, 45, 1);
  letter-spacing: normal;
  text-transform: initial;
  white-space: nowrap;
}
.alora-bundle-badge::before,
.alora-bundle-badge::after {
  display: block;
  position: absolute;
  top: 0;
  width: 0;
  height: 0;
  content: "";
  border-bottom: 8px solid rgba(1, 85, 45, 1);
  filter: brightness(.7);
}
.alora-bundle-badge::before {
  left: 0;
  border-left: 8px solid transparent;
  transform: translateX(-8px);
}
.alora-bundle-badge::after {
  right: 0;
  border-right: 8px solid transparent;
  transform: translateX(8px);
}

.alora-sub-wrap { margin-top: 12px; }
.alora-sub-box {
  display: flex;
  align-items: center;
  gap: 14px;
  border: 2.5px dashed #a8c5b0;
  border-radius: 16px;
  padding: 11px 16px;
  cursor: pointer;
  user-select: none;
  background: #fff;
  transition: border-color .18s, background .18s;
}
.alora-sub-box.is-on {
  border-color: #2d6a4f;
  background: #f0faf4;
}
.alora-sub-chk {
  flex-shrink: 0;
  width: 22px !important;
  height: 22px !important;
  border: 2px solid #ccc;
  border-radius: 4px;
  background: #fff;
  display: flex; align-items: center; justify-content: center;
  transition: all .18s;
}
.alora-sub-box.is-on .alora-sub-chk {
  background: rgb(45, 106, 79);
  border-color: rgb(45, 106, 79);
}
.alora-sub-chk svg {
  display: none;
  width: 13px !important; height: 13px !important;
  stroke: #fff; fill: none;
  stroke-width: 2.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.alora-sub-box.is-on .alora-sub-chk svg { display: block; }
.alora-sub-label { flex: 1; }
.alora-sub-title {
  font-size: 16px;
  font-weight: 800;
  letter-spacing: normal;
  color: #000000;
}
.alora-sub-desc {
  font-size: 13px;
  color: #888;
   letter-spacing: normal;
  margin-top: 3px;
  font-weight: 400;
}

.alora-atc {
  display: block;
  width: 100%;
  margin-top: 12px;
  padding: 15px 24px;
  background: rgba(1, 85, 45, 1);
  color: #fff;
  border: none;
  border-radius: 12px;
  font-size: 17px;
  font-weight: 800;
  letter-spacing: 2px;
  cursor: pointer;
  transition: background .18s, opacity .18s;
  font-family: 'Inter', sans-serif;
  margin-bottom:10px;
}
.alora-atc:hover { background: #144d2f; }
.alora-atc:disabled { opacity: .6; cursor: not-allowed; }
.alora-atc.is-loading { opacity: .7; pointer-events: none; }

.alora-sale-banner {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 20px 0 18px;
}
.alora-sale-line {
  flex: 1;
  height: 1.5px;
  background: #b8d4bc;
  border-radius: 2px;
}
.alora-sale-text {
  font-size: 16px;
  font-weight: 800;
  color: #000000;
  white-space: nowrap;
  font-family: 'Inter', sans-serif;
}
.bar2,.bar3{
  padding: 15px 14px !important;
}
.alora-bundle-price-col {
    margin-top: 7px;
}
.bar1{
  padding: 8px 14px;
}
.alora-sub-chk {
    flex-shrink: 0;
    width: 22px !important;
    height: 22px !important;
}
.alora-sub-chk svg {
    width: 13px !important;
    height: 13px !important;
  }
@media (max-width: 480px) {
.alora-bundle-bar{
    padding: 8px 14px;
}
.alora-sale-banner {
  display: flex;
  align-items: center;
  gap: 12px;
    margin: 15px 0 10px;
}
.alora-sale-text{
  font-size:14px !important;
}
.alora-sub-box{
  padding: 10px 14px;
}
.alora-sub-title{
    font-size:15px !important;
}
.alora-sub-desc {
    font-size: 12px;
    color: #888;
    margin-top: 0px;
    font-weight: 400;
}
}

@media (max-width: 380px) {
.alora-bundle-savings
{
font-size:12px;
}
}
.alora-free-item
{
margin-top:15px;
}
</style>

