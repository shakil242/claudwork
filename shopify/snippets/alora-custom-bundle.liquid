<script>
if (!window._aloraCustomBundleInit) {
window._aloraCustomBundleInit = true;

(function () {
  var SUPPORTED_HANDLES = [
    'lymphatic-drainages-drops',
    'lymphatic-drainage-wellness-drops',
    'lymphatic-drainage-drops',
    'nitric-oxide-support-capsules',
    'vaginal-probotics'
  ];

  var currentHandle = window.location.pathname.split('/products/')[1];
  currentHandle = currentHandle ? currentHandle.split('?')[0].split('/')[0] : '';
  if (SUPPORTED_HANDLES.indexOf(currentHandle) === -1) return;

  var HANDLE_MAPS = {
    'lymphatic-drainages-drops': {
      '1': { variantId: '54111451087123', oneTime: '5.15', sub: '22.15', oneTimePrice: '$45.00', subPrice: '$36.00', comparePrice: '$90.00' },
      '2': { variantId: '54111451119891', oneTime: '5.16', sub: '23.16', oneTimePrice: '$90.00', subPrice: '$72.00', comparePrice: '$270.00' },
      '3': { variantId: '54111451152659', oneTime: '5.17', sub: '24.17', oneTimePrice: '$135.00', subPrice: '$108.00', comparePrice: '$450.00' }
    },
    'lymphatic-drainage-wellness-drops': {
      '1': { variantId: '54111451087123', oneTime: '5.15', sub: '22.15', oneTimePrice: '$45.00', subPrice: '$36.00', comparePrice: '$90.00' },
      '2': { variantId: '54111451119891', oneTime: '5.16', sub: '23.16', oneTimePrice: '$90.00', subPrice: '$72.00', comparePrice: '$270.00' },
      '3': { variantId: '54111451152659', oneTime: '5.17', sub: '24.17', oneTimePrice: '$135.00', subPrice: '$108.00', comparePrice: '$450.00' }
    },
    'lymphatic-drainage-drops': {
      '1': { variantId: '54111451087123', oneTime: '5.15', sub: '22.15', oneTimePrice: '$45.00', subPrice: '$36.00', comparePrice: '$90.00' },
      '2': { variantId: '54111451119891', oneTime: '5.16', sub: '23.16', oneTimePrice: '$90.00', subPrice: '$72.00', comparePrice: '$270.00' },
      '3': { variantId: '54111451152659', oneTime: '5.17', sub: '24.17', oneTimePrice: '$135.00', subPrice: '$108.00', comparePrice: '$450.00' }
    },
    'nitric-oxide-support-capsules': {
      '1': { variantId: '54111468224787', oneTime: '7.21', sub: '26.21', oneTimePrice: '$45.00', subPrice: '$36.00', comparePrice: '$90.00' },
      '2': { variantId: '54111468257555', oneTime: '7.22', sub: '27.22', oneTimePrice: '$90.00', subPrice: '$72.00', comparePrice: '$270.00' },
      '3': { variantId: '54111468290323', oneTime: '7.23', sub: '28.23', oneTimePrice: '$135.00', subPrice: '$108.00', comparePrice: '$450.00' }
    },
    'vaginal-probotics': {
      '1': { variantId: '54119722844435', oneTime: '32.25', sub: '33.25', oneTimePrice: '$45.00', subPrice: '$36.00', comparePrice: '$90.00' },
      '2': { variantId: '54119722877203', oneTime: '32.26', sub: '34.26', oneTimePrice: '$90.00', subPrice: '$72.00', comparePrice: '$270.00' },
      '3': { variantId: '54119722909971', oneTime: '32.27', sub: '35.27', oneTimePrice: '$135.00', subPrice: '$108.00', comparePrice: '$450.00' }
    }
  };

  var TIER_MAP = HANDLE_MAPS[currentHandle];
  if (!TIER_MAP) return;

  var CC_BASE = ['nitric-oxide-support-capsules', 'vaginal-probotics'].indexOf(currentHandle) !== -1
    ? 'https://checkout.aloradrops.com/secure-checkout'
    : 'https://checkout.aloradrops.com/checkout';

  var selectedTier = '2';
  var subOn        = false;

  var wrap   = document.getElementById('alora-bundle-wrap');
  var bars   = wrap ? wrap.querySelectorAll('.alora-bundle-bar') : [];
  var subBox = document.getElementById('alora-sub-box');
  var atcBtn = document.getElementById('alora-atc');

  if (!wrap || !bars.length || !subBox || !atcBtn) return;

  function syncPagePrice() {
    var map = TIER_MAP[selectedTier];
    if (!map) return;
    var displayPrice = subOn ? map.subPrice : map.oneTimePrice;
    document.querySelectorAll('.price-item--regular').forEach(function (el) {
      if (el.tagName === 'S' || el.closest('s')) return;
      el.innerHTML = displayPrice;
    });
    document.querySelectorAll('.price-item--compare-at, .price-item--sale, .price__compare-at').forEach(function (el) {
      el.style.display = 'none';
    });
  }

  function renderPrices() {
    bars.forEach(function (bar) {
      var tier = bar.getAttribute('data-tier');
      var map  = TIER_MAP[tier];
      if (!map) return;
      var main    = bar.querySelector('[data-price-main]');
      var compare = bar.querySelector('[data-price-compare]');
      if (main)    main.textContent = subOn ? map.subPrice : map.oneTimePrice;
      if (compare) compare.textContent = map.comparePrice;
    });
    syncPagePrice();
  }

  function selectTier(tier) {
    selectedTier = tier;
    bars.forEach(function (bar) {
      bar.classList.toggle('is-selected', bar.getAttribute('data-tier') === tier);
    });
    var hidden = document.querySelector('input.product-variant-id[name="id"], input[name="id"]');
    if (hidden) {
      hidden.value = TIER_MAP[tier].variantId;
      hidden.dispatchEvent(new Event('change', { bubbles: true }));
    }
    syncPagePrice();
  }

  bars.forEach(function (bar) {
    bar.addEventListener('click', function () { selectTier(bar.getAttribute('data-tier')); });
  });

  subBox.addEventListener('click', function () {
    subOn = !subOn;
    subBox.classList.toggle('is-on', subOn);
    renderPrices();
  });

  function buildRedirectUrl(ccId) {
    var c = document.cookie.match(/cart=([^;]+)/);
    var a = document.cookie.match(/affId=([^;]+)/);
    var url = CC_BASE + '?products=' + ccId + ':1&cartId=' + (c ? c[1] : '');
    if (a) url += '&affId=' + a[1];
    return url;
  }

  /* Store CC ID for checkout intercept */
  function storeCCId() {
    var map = TIER_MAP[selectedTier];
    if (!map) return;
    window._aloraPendingCCId = subOn ? map.sub : map.oneTime;
    window._aloraPendingCCBase = CC_BASE;
  }

  /* Override Shrine checkout button to redirect to CC */
  window.checkoutLoad = function(e) {
    e.preventDefault();
    var ccId = window._aloraPendingCCId;
    if (!ccId) { window.location.href = '/checkout'; return; }
    var c = document.cookie.match(/cart=([^;]+)/);
    var a = document.cookie.match(/affId=([^;]+)/);
    var url = (window._aloraPendingCCBase || CC_BASE) + '?products=' + ccId + ':1&cartId=' + (c ? c[1] : '');
    if (a) url += '&affId=' + a[1];
    window.location.href = url;
  };

  /* Capture phase backup */
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('#CartDrawer-Checkout');
    if (!btn || !window._aloraPendingCCId) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    window.checkoutLoad(e);
  }, true);

  /* Removing either bundle row clears the whole (fixed) bundle. */
  function clearBundleAndRefresh() {
    fetch('/cart/clear.js', { method: 'POST' })
      .then(function() { return fetch('/cart?sections=cart-drawer,cart-icon-bubble'); })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var section = document.getElementById('shopify-section-cart-drawer');
        if (section && data['cart-drawer']) section.innerHTML = data['cart-drawer'];
        window._aloraPendingCCId = null;
      })
      .catch(function() {});
  }
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.alora-free-remove')) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    clearBundleAndRefresh();
  }, true);

atcBtn.addEventListener('click', function () {
  var map = TIER_MAP[selectedTier];
  if (!map) return;
  window._aloraPendingCCId = subOn ? map.sub : map.oneTime;
  window._aloraPendingCCBase = CC_BASE;
  atcBtn.classList.add('is-loading');
  atcBtn.textContent = 'ADDING...';

  fetch('/cart/clear.js', { method: 'POST' })
  .then(function() {
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: parseInt(map.variantId, 10), quantity: 1 }] })
    });
  })
  .then(function(r) { return r.json(); })
  .then(function() {
    return fetch('/cart?sections=cart-drawer,cart-icon-bubble');
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    var section = document.getElementById('shopify-section-cart-drawer');
    if (section && data['cart-drawer']) {
      section.innerHTML = data['cart-drawer'];
    }
    atcBtn.classList.remove('is-loading');
    atcBtn.textContent = 'ADD TO CART';
    var drawer = document.querySelector('cart-drawer');
    if (drawer && typeof drawer.open === 'function') {
      drawer.open();
      setTimeout(overrideCartDrawerPrices, 300);
      setTimeout(overrideCartDrawerPrices, 700);
    }
    /* Reset drawer HTML when closed so reopening via cart icon re-fetches */
    var closeBtn = document.querySelector('cart-drawer [data-drawer-close], #CartDrawer-Overlay, .cart-drawer__overlay');
    if (closeBtn) {
      closeBtn.addEventListener('click', function resetOnce() {
        fetch('/cart?sections=cart-drawer')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (section && data['cart-drawer']) section.innerHTML = data['cart-drawer'];
        });
        closeBtn.removeEventListener('click', resetOnce);
      });
    }
  })
  .catch(function() {
    atcBtn.classList.remove('is-loading');
    atcBtn.textContent = 'ADD TO CART';
  });
});

  function overridePrices() {
    var map = TIER_MAP[selectedTier];
    if (!map) return;
    var price = subOn ? map.subPrice : map.oneTimePrice;
    var drawer = document.querySelector('cart-drawer');
    if (!drawer) return;
    drawer.querySelectorAll('.price--end.regular-price').forEach(function(el){
      if (el.closest('.alora-free-item')) return; /* never touch the free row */
      el.textContent = price;
    });
    drawer.querySelectorAll('.cart-drawer__totals__row__money').forEach(function(el){
      if (el.closest('.alora-free-item')) return;
      el.textContent = price;
    });
  }

  new MutationObserver(function(muts) {
    muts.forEach(function(m) {
      if (m.type === 'childList') {
        var has = Array.from(m.addedNodes).some(function(n){ return n.nodeType===1 && n.querySelector && n.querySelector('.price--end'); });
        if (has) setTimeout(overridePrices, 50);
      }
    });
  }).observe(document.body, { childList: true, subtree: true });

function overrideCartDrawerPrices() {
  var map = TIER_MAP[selectedTier]; if (!map) return;
  var price = subOn ? map.subPrice : map.oneTimePrice;
  var drawer = document.querySelector('cart-drawer'); if (!drawer) return;

  /* Override subtotal */
  drawer.querySelectorAll('.cart-drawer__totals__row__money, .totals__subtotal-value').forEach(function(el){
    el.textContent = price;
  });

  /* Override main (paid) item — never the injected free row. */
  var realItem = drawer.querySelector('.cart-items li.cart-item:not(.alora-free-item), .cart-items li[class*="cart-item"]:not(.alora-free-item)')
              || drawer.querySelector('.cart-item:not(.alora-free-item)');
  if (realItem) {
    var paidQty = selectedTier === '2' ? 2 : selectedTier === '3' ? 3 : 1;

    /* Total price (skip strikethrough / compare prices); write only if changed. */
    realItem.querySelectorAll('.price--end.regular-price, .cart-item__final-price, .price--end .money').forEach(function(el){
      if (el.closest('s') || el.closest('[class*="compare"]') || el.closest('[class*="old"]')) return;
      if (el.textContent.trim() !== price) el.textContent = price;
    });

    /* Show the paid quantity; keep the native stepper visible (matches
       purealora) but inert so the fixed bundle can't be changed. */
    var qtyInput = realItem.querySelector('.quantity__input, input[type="number"]');
    if (qtyInput) { qtyInput.value = paidQty; qtyInput.setAttribute('value', paidQty); qtyInput.readOnly = true; }
    realItem.querySelectorAll('.quantity__button').forEach(function(b){
      b.setAttribute('disabled', 'disabled'); b.style.pointerEvents = 'none'; b.style.opacity = '0.35';
    });

    /* Drop the old custom "Qty: N" pill if a previous version left one. */
    realItem.querySelectorAll('.alora-qty-badge').forEach(function(el){ el.remove(); });
  }

  injectFreeItems();
  overrideCartCount();
}

/* Show the full bundle count (paid + free) in the drawer heading and the
   header cart bubble, instead of the single real line (1). */
function overrideCartCount() {
  if (!window._aloraPendingCCId) return;
  var total = selectedTier === '2' ? 3 : selectedTier === '3' ? 5 : 1;

  document.querySelectorAll('.drawer__heading, [class*="cart-drawer"] h2, .cart-drawer__heading').forEach(function(el){
    if (!/\d/.test(el.textContent)) return;
    var next = el.textContent.replace(/\d+/, total);
    if (el.textContent !== next) el.textContent = next;
  });

  document.querySelectorAll('.cart-count-bubble span[aria-hidden="true"], .cart-count-bubble > span:first-child, .cart-count').forEach(function(el){
    if (el.classList.contains('visually-hidden')) return;
    if (el.textContent.trim() !== String(total)) el.textContent = total;
  });
}

function injectFreeItems() {
  var drawer = document.querySelector('cart-drawer'); if (!drawer) return;
  if (!window._aloraPendingCCId) return;

  /* Skip the rebuild when the existing free row already matches the current
     selection — prevents the remove/re-add churn that caused flickering. */
  var freeKey = selectedTier + '|' + (subOn ? '1' : '0');
  var current = drawer.querySelector('.alora-free-item');
  if (current && current.getAttribute('data-alora-key') === freeKey) return;
  drawer.querySelectorAll('.alora-free-item').forEach(function(el){ el.remove(); });

  var map = TIER_MAP[selectedTier]; if (!map) return;
  var freeQty = selectedTier === '2' ? 1 : selectedTier === '3' ? 2 : 0;
  var paidQty = selectedTier === '2' ? 2 : selectedTier === '3' ? 3 : 1;
  var label   = selectedTier === '2' ? 'Buy 2, Get 1 Free' : 'Buy 3, Get 2 Free';
  if (freeQty === 0) return;

  var list = drawer.querySelector('.cart-items'); if (!list) return;
  var realItem = list.querySelector('li.cart-item:not(.alora-free-item), li[class*="cart-item"]:not(.alora-free-item)');
  if (!realItem) return;

  var img       = realItem.querySelector('img.cart-item__image, .cart-item__media img, img');
  var imgSrc    = img ? img.getAttribute('src') : '';
  var titleEl   = realItem.querySelector('.cart-item__name, a[class*="name"], [class*="cart-item__title"]');
  var titleText = titleEl ? titleEl.textContent.trim() : 'Lymphatic Drainage Drops';

  var total     = parseFloat((subOn ? map.subPrice : map.oneTimePrice).replace(/[^0-9.]/g, ''));
  var perBottle = total / paidQty;
  var oldTotal  = perBottle * freeQty;
  var fmt = function(n){ return '$' + n.toFixed(2); };

  /* Native theme SVGs (copied from the store's own cart drawer markup). */
  var DISCOUNT_SVG = '<svg aria-hidden="true" focusable="false" class="icon icon-discount color-foreground-text" viewBox="0 0 12 12"><path fill-rule="evenodd" clip-rule="evenodd" d="M7 0h3a2 2 0 012 2v3a1 1 0 01-.3.7l-6 6a1 1 0 01-1.4 0l-4-4a1 1 0 010-1.4l6-6A1 1 0 017 0zm2 2a1 1 0 102 0 1 1 0 00-2 0z" fill="currentColor"></path></svg>';
  var TRASH_SVG = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="icon icon-remove"><path d="M14 3h-3.53a3.07 3.07 0 00-.6-1.65C9.44.82 8.8.5 8 .5s-1.44.32-1.87.85A3.06 3.06 0 005.53 3H2a.5.5 0 000 1h1.25v10c0 .28.22.5.5.5h8.5a.5.5 0 00.5-.5V4H14a.5.5 0 000-1zM6.91 1.98c.23-.29.58-.48 1.09-.48s.85.19 1.09.48c.2.24.3.6.36 1.02h-2.9c.05-.42.17-.78.36-1.02zm4.84 11.52h-7.5V4h7.5v9.5z" fill="currentColor"></path><path d="M6.55 5.25a.5.5 0 00-.5.5v6a.5.5 0 001 0v-6a.5.5 0 00-.5-.5zM9.45 5.25a.5.5 0 00-.5.5v6a.5.5 0 001 0v-6a.5.5 0 00-.5-.5z" fill="currentColor"></path></svg>';
  var MINUS_SVG = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor"><path d="M432 256c0 17.7-14.3 32-32 32L48 288c-17.7 0-32-14.3-32-32s14.3-32 32-32l352 0c17.7 0 32 14.3 32 32z"></path></svg>';
  var PLUS_SVG  = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor"><path d="M256 80c0-17.7-14.3-32-32-32s-32 14.3-32 32V224H48c-17.7 0-32 14.3-32 32s14.3 32 32 32H192V432c0 17.7 14.3 32 32 32s32-14.3 32-32V288H400c17.7 0 32-14.3 32-32s-14.3-32-32-32H256V80z"></path></svg>';

  var li = document.createElement('li');
  li.className = 'cart-drawer-item cart-item alora-free-item';
  li.setAttribute('role', 'row');
  li.setAttribute('data-alora-key', freeKey);
  li.innerHTML = [
    '<div class="cart-item__media" role="cell">',
      imgSrc ? '<img class="cart-item__image" src="' + imgSrc + '" alt="" loading="lazy" width="150" height="150">' : '',
    '</div>',
    '<div class="cart-drawer-item__right">',
      '<div class="cart-drawer-item__details-and-delete-btn">',
        '<div class="cart-item__details" role="cell">',
          '<h4 class="cart-item__name h4 break">' + titleText + '</h4>',
          '<div class="cart-item__discounted-prices cart-drawer-item__single-item-prices">',
            '<span>',
              '<s class="cart-item__old-price product-option text-color-text">' + fmt(perBottle) + '</s>',
              '<strong class="cart-item__final-price product-option text-color-accent-1">$0.00</strong>',
            '</span>',
            '<div class="cart-drawer__discounts list-unstyled" role="list" aria-label="Discount">',
              '<div class="badge">' + DISCOUNT_SVG + '<span>' + label + '</span></div>',
            '</div>',
          '</div>',
          '<p class="product-option">Free Express Shipping</p>',
        '</div>',
        '<div class="cart-drawer-item__cart-remove-button alora-free-remove">',
          '<button type="button" class="button button--tertiary" aria-label="Remove ' + titleText + '">' + TRASH_SVG + '</button>',
        '</div>',
      '</div>',
      '<div class="cart-drawer-item__quantity-and-prices cart-drawer-item__quantity-and-prices--has-props">',
        '<div class="cart-item__quantity">',
          '<div class="cart-item__quantity-wrapper">',
            '<quantity-input class="quantity cart-quantity color-background-2 cart-quantity--round-btns">',
              '<button class="quantity__button quantity__button--minus no-js-hidden color-background-2" name="minus" type="button" disabled style="pointer-events:none;opacity:.35;">' + MINUS_SVG + '</button>',
              '<input class="quantity__input" type="number" value="' + freeQty + '" min="1" readonly aria-label="Quantity">',
              '<button class="quantity__button quantity__button--plus no-js-hidden color-background-2" name="plus" type="button" disabled style="pointer-events:none;opacity:.35;">' + PLUS_SVG + '</button>',
            '</quantity-input>',
          '</div>',
        '</div>',
        '<div class="cart-item__totals right" role="cell">',
          '<div class="cart-item__price-wrapper">',
            '<div class="cart-item__discounted-prices">',
              '<s class="cart-item__old-price price--end compare-price color-foreground-text">' + fmt(oldTotal) + '</s>',
              '<span class="price--end regular-price accent-color-accent-1">$0.00</span>',
            '</div>',
            '<span class="cart-drawer-item__saving text-color-text"><strong>(You save ' + fmt(oldTotal) + ')</strong></span>',
          '</div>',
        '</div>',
      '</div>',
    '</div>'
  ].join('');

  /* Free item listed first, exactly like purealora. */
  list.insertBefore(li, realItem);
}
  /* ── Watch for cart drawer opening via header cart icon ── */
  new MutationObserver(function(muts) {
    muts.forEach(function(m) {
      if (m.type === 'attributes' && m.attributeName === 'class') {
        var el = m.target;
        if (el.tagName && el.tagName.toLowerCase() === 'cart-drawer') {
          var isOpen = el.classList.contains('active') || el.classList.contains('is-open') || el.classList.contains('open');
          if (isOpen && window._aloraPendingCCId) {
            setTimeout(overrideCartDrawerPrices, 200);
            setTimeout(overrideCartDrawerPrices, 600);
          }
        }
      }
      /* Watch for new cart items rendered */
      if (m.type === 'childList') {
        var has = Array.from(m.addedNodes).some(function(n){
          return n.nodeType === 1 && n.querySelector && n.querySelector('.price--end');
        });
        if (has && window._aloraPendingCCId) setTimeout(overrideCartDrawerPrices, 100);
      }
    });
  }).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });

  renderPrices();
  selectTier(selectedTier);
})();

}

</script>
