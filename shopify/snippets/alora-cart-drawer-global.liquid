{% comment %}
  ══════════════════════════════════════════════════════════════
  snippets/alora-cart-drawer-global.liquid

  GLOBAL cart-drawer bundle styling. Include ONCE in theme.liquid
  (e.g. just before </body>):

      {% render 'alora-cart-drawer-global' %}

  It reapplies the "Buy X Get Y Free" presentation (free row at $0.00,
  prices, item count, non-clickable steppers, CC checkout redirect) to the
  cart drawer when it is opened from the header on any page.

  State comes from localStorage('aloraBundle'), written by
  snippets/alora-custom-bundle.liquid on Add-to-Cart. On the supported
  PRODUCT pages this file does nothing — that snippet already handles the
  drawer there (prevents double-binding).
{% endcomment %}

<style>
  .alora-free-item { margin-top:15px; }
  .alora-free-item .alora-free-remove { background:none; border:0; padding:0; cursor:pointer; }
  .alora-free-item .alora-free-remove .button { background:none!important; border:0!important; box-shadow:none!important; padding:0!important; min-width:0!important; width:auto!important; height:auto!important; }
  .alora-free-item .alora-free-remove svg, .alora-free-item svg.alora-trash { width:18px!important; height:18px!important; max-width:18px!important; max-height:18px!important; flex:0 0 auto!important; }
  cart-drawer .drawer__close, .cart-drawer__close, #CartDrawer .drawer__close { background:transparent!important; border:0!important; box-shadow:none!important; }
  cart-drawer .drawer__close svg, .cart-drawer__close svg { width:2.2rem!important; height:2.2rem!important; }
</style>

<script>
if (!window._aloraDrawerGlobalInit) {
window._aloraDrawerGlobalInit = true;
(function () {
  var SUPPORTED_HANDLES = [
    'lymphatic-drainages-drops',
    'lymphatic-drainage-wellness-drops',
    'lymphatic-drainage-drops',
    'nitric-oxide-support-capsules',
    'vaginal-probotics'
  ];

  /* On a supported product page the product snippet handles the drawer. */
  var path = window.location.pathname.split('/products/')[1];
  var onHandle = path ? path.split('?')[0].split('/')[0] : '';
  if (SUPPORTED_HANDLES.indexOf(onHandle) !== -1) return;

  /* Restore the saved bundle selection. Nothing to do if there isn't one. */
  var saved;
  try { saved = JSON.parse(localStorage.getItem('aloraBundle') || 'null'); } catch (e) { saved = null; }
  if (!saved || !saved.ccId) return;

  var HANDLE_MAPS = {
    'lymphatic-drainages-drops': {
      '1': { oneTimePrice: '$45.00', subPrice: '$36.00', comparePrice: '$90.00' },
      '2': { oneTimePrice: '$90.00', subPrice: '$72.00', comparePrice: '$270.00' },
      '3': { oneTimePrice: '$135.00', subPrice: '$108.00', comparePrice: '$450.00' }
    },
    'lymphatic-drainage-wellness-drops': {
      '1': { oneTimePrice: '$45.00', subPrice: '$36.00', comparePrice: '$90.00' },
      '2': { oneTimePrice: '$90.00', subPrice: '$72.00', comparePrice: '$270.00' },
      '3': { oneTimePrice: '$135.00', subPrice: '$108.00', comparePrice: '$450.00' }
    },
    'lymphatic-drainage-drops': {
      '1': { oneTimePrice: '$45.00', subPrice: '$36.00', comparePrice: '$90.00' },
      '2': { oneTimePrice: '$90.00', subPrice: '$72.00', comparePrice: '$270.00' },
      '3': { oneTimePrice: '$135.00', subPrice: '$108.00', comparePrice: '$450.00' }
    },
    'nitric-oxide-support-capsules': {
      '1': { oneTimePrice: '$45.00', subPrice: '$36.00', comparePrice: '$90.00' },
      '2': { oneTimePrice: '$90.00', subPrice: '$72.00', comparePrice: '$270.00' },
      '3': { oneTimePrice: '$135.00', subPrice: '$108.00', comparePrice: '$450.00' }
    },
    'vaginal-probotics': {
      '1': { oneTimePrice: '$45.00', subPrice: '$36.00', comparePrice: '$90.00' },
      '2': { oneTimePrice: '$90.00', subPrice: '$72.00', comparePrice: '$270.00' },
      '3': { oneTimePrice: '$135.00', subPrice: '$108.00', comparePrice: '$450.00' }
    }
  };

  var TIER_MAP      = HANDLE_MAPS[saved.handle];
  if (!TIER_MAP) return;
  var selectedTier  = saved.tier || '2';
  var subOn         = !!saved.sub;
  window._aloraPendingCCId   = saved.ccId;
  window._aloraPendingCCBase = saved.ccBase || 'https://checkout.aloradrops.com/checkout';

  /* ── Checkout intercept → CheckoutChamp ── */
  window.checkoutLoad = function (e) {
    if (e) e.preventDefault();
    var ccId = window._aloraPendingCCId;
    if (!ccId) { window.location.href = '/checkout'; return; }
    var c = document.cookie.match(/cart=([^;]+)/);
    var a = document.cookie.match(/affId=([^;]+)/);
    var url = (window._aloraPendingCCBase) + '?products=' + ccId + ':1&cartId=' + (c ? c[1] : '');
    if (a) url += '&affId=' + a[1];
    window.location.href = url;
  };
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('#CartDrawer-Checkout');
    if (!btn || !window._aloraPendingCCId) return;
    e.preventDefault(); e.stopImmediatePropagation();
    window.checkoutLoad(e);
  }, true);

  /* ── Remove → clear whole bundle ── */
  function clearBundleAndRefresh() {
    fetch('/cart/clear.js', { method: 'POST' })
      .then(function () { return fetch('/cart?sections=cart-drawer,cart-icon-bubble'); })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var section = document.getElementById('shopify-section-cart-drawer');
        if (section && data['cart-drawer']) section.innerHTML = data['cart-drawer'];
        window._aloraPendingCCId = null;
        try { localStorage.removeItem('aloraBundle'); } catch (e) {}
      })
      .catch(function () {});
  }
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.alora-free-remove')) return;
    e.preventDefault(); e.stopImmediatePropagation();
    clearBundleAndRefresh();
  }, true);

  function buildStepperHTML(qty) {
    var MINUS = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor"><path d="M432 256c0 17.7-14.3 32-32 32L48 288c-17.7 0-32-14.3-32-32s14.3-32 32-32l352 0c17.7 0 32 14.3 32 32z"></path></svg>';
    var PLUS  = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor"><path d="M256 80c0-17.7-14.3-32-32-32s-32 14.3-32 32V224H48c-17.7 0-32 14.3-32 32s14.3 32 32 32H192V432c0 17.7 14.3 32 32 32s32-14.3 32-32V288H400c17.7 0 32-14.3 32-32s-14.3-32-32-32H256V80z"></path></svg>';
    return '<quantity-input class="quantity cart-quantity color-background-2 cart-quantity--round-btns" style="--font-size:1.4rem;--border-width:0.1rem;--border-color:#787878;--corner-radius:0.6rem;--container-padding:0em;--input-padding:0.7em;--separator-opacity:0.2;--padding:0.4em;--icon-size:0.7em;">'
      + '<button class="quantity__button quantity__button--minus no-js-hidden color-background-2" name="minus" type="button" disabled style="pointer-events:none;opacity:.4;">' + MINUS + '</button>'
      + '<input class="quantity__input" type="number" value="' + qty + '" min="1" readonly aria-label="Quantity">'
      + '<button class="quantity__button quantity__button--plus no-js-hidden color-background-2" name="plus" type="button" disabled style="pointer-events:none;opacity:.4;">' + PLUS + '</button>'
      + '</quantity-input>';
  }

  function overridePrices() {
    var price = subOn ? TIER_MAP[selectedTier].subPrice : TIER_MAP[selectedTier].oneTimePrice;
    var drawer = document.querySelector('cart-drawer'); if (!drawer) return;
    drawer.querySelectorAll('.price--end.regular-price').forEach(function (el) { if (el.closest('.alora-free-item')) return; el.textContent = price; });
    drawer.querySelectorAll('.cart-drawer__totals__row__money').forEach(function (el) { if (el.closest('.alora-free-item')) return; el.textContent = price; });
  }

  function overrideCartDrawerPrices() {
    var map = TIER_MAP[selectedTier]; if (!map) return;
    var price = subOn ? map.subPrice : map.oneTimePrice;
    var drawer = document.querySelector('cart-drawer'); if (!drawer) return;

    drawer.querySelectorAll('.cart-drawer__totals__row__money, .totals__subtotal-value').forEach(function (el) { el.textContent = price; });

    var realItem = drawer.querySelector('.cart-items li.cart-item:not(.alora-free-item), .cart-items li[class*="cart-item"]:not(.alora-free-item)')
                || drawer.querySelector('.cart-item:not(.alora-free-item)');
    if (realItem) {
      var paidQty = selectedTier === '2' ? 2 : selectedTier === '3' ? 3 : 1;
      realItem.querySelectorAll('.price--end.regular-price, .cart-item__final-price, .price--end .money').forEach(function (el) {
        if (!el.closest('s') && !el.closest('[class*="compare"]') && !el.closest('[class*="old"]')) el.textContent = price;
      });
      var qtyInput = realItem.querySelector('.quantity__input, input[type="number"]');
      if (qtyInput) {
        qtyInput.value = paidQty; qtyInput.setAttribute('value', paidQty); qtyInput.readOnly = true;
        realItem.querySelectorAll('.quantity__button').forEach(function (b) { b.setAttribute('disabled', 'disabled'); b.style.pointerEvents = 'none'; b.style.opacity = '0.4'; });
      } else {
        var qc = realItem.querySelector('.cart-item__quantity');
        if (qc && !qc.querySelector('.quantity__input')) {
          var w = document.createElement('div'); w.className = 'cart-item__quantity-wrapper';
          w.innerHTML = buildStepperHTML(paidQty); qc.insertBefore(w, qc.firstChild);
        }
      }
    }
    injectFreeItems();
    overrideCartCount();
  }

  function overrideCartCount() {
    if (!window._aloraPendingCCId) return;
    var d = document.querySelector('cart-drawer');
    if (!d || !d.querySelector('.cart-items li.cart-item:not(.alora-free-item)')) return;
    var paidQty = selectedTier === '2' ? 2 : selectedTier === '3' ? 3 : 1;
    var freeQty = selectedTier === '2' ? 1 : selectedTier === '3' ? 2 : 0;
    var total = paidQty + freeQty;
    document.querySelectorAll('.drawer__heading, [class*="cart-drawer"] h2').forEach(function (el) {
      if (!/\d/.test(el.textContent)) return;
      var next = el.textContent.replace(/\d+/, total);
      if (el.textContent !== next) el.textContent = next;
    });
    document.querySelectorAll('.cart-count-bubble span[aria-hidden="true"], .cart-count').forEach(function (el) {
      if (el.classList && el.classList.contains('visually-hidden')) return;
      if (el.textContent.trim() !== String(total)) el.textContent = total;
    });
  }

  function injectFreeItems() {
    var drawer = document.querySelector('cart-drawer'); if (!drawer) return;
    if (!window._aloraPendingCCId) return;

    var freeKey = selectedTier + '|' + (subOn ? '1' : '0');
    var current = drawer.querySelector('.alora-free-item');
    if (current && current.getAttribute('data-alora-key') === freeKey) return;
    drawer.querySelectorAll('.alora-free-item').forEach(function (el) { el.remove(); });

    var map = TIER_MAP[selectedTier]; if (!map) return;
    var freeQty = selectedTier === '2' ? 1 : selectedTier === '3' ? 2 : 0;
    var paidQty = selectedTier === '2' ? 2 : selectedTier === '3' ? 3 : 1;
    var label   = selectedTier === '2' ? 'Buy 2, Get 1 Free' : 'Buy 3, Get 2 Free';
    if (freeQty === 0) return;

    var list = drawer.querySelector('.cart-items'); if (!list) return;
    var realItem = list.querySelector('li.cart-item:not(.alora-free-item), li[class*="cart-item"]:not(.alora-free-item)');
    if (!realItem) return;

    var img       = realItem.querySelector('img.cart-item__image, .cart-item__media img, img');
    var imgSrc    = img ? img.getAttribute('src') : '';
    var titleEl   = realItem.querySelector('.cart-item__name, a[class*="name"], [class*="cart-item__title"]');
    var titleText = titleEl ? titleEl.textContent.trim() : 'Lymphatic Drainage Drops';

    var totalNum  = parseFloat((subOn ? map.subPrice : map.oneTimePrice).replace(/[^0-9.]/g, ''));
    var perBottle = totalNum / paidQty;
    var oldTotal  = perBottle * freeQty;
    var fmt = function (n) { return '$' + n.toFixed(2); };

    var DISCOUNT_SVG = '<svg aria-hidden="true" focusable="false" class="icon icon-discount color-foreground-text" viewBox="0 0 12 12"><path fill-rule="evenodd" clip-rule="evenodd" d="M7 0h3a2 2 0 012 2v3a1 1 0 01-.3.7l-6 6a1 1 0 01-1.4 0l-4-4a1 1 0 010-1.4l6-6A1 1 0 017 0zm2 2a1 1 0 102 0 1 1 0 00-2 0z" fill="currentColor"></path></svg>';
    var TRASH_SVG = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="18" height="18" style="width:18px!important;height:18px!important;max-width:18px;max-height:18px;display:inline-block;" aria-hidden="true" focusable="false" class="alora-trash"><path d="M14 3h-3.53a3.07 3.07 0 00-.6-1.65C9.44.82 8.8.5 8 .5s-1.44.32-1.87.85A3.06 3.06 0 005.53 3H2a.5.5 0 000 1h1.25v10c0 .28.22.5.5.5h8.5a.5.5 0 00.5-.5V4H14a.5.5 0 000-1zM6.91 1.98c.23-.29.58-.48 1.09-.48s.85.19 1.09.48c.2.24.3.6.36 1.02h-2.9c.05-.42.17-.78.36-1.02zm4.84 11.52h-7.5V4h7.5v9.5z" fill="currentColor"></path><path d="M6.55 5.25a.5.5 0 00-.5.5v6a.5.5 0 001 0v-6a.5.5 0 00-.5-.5zM9.45 5.25a.5.5 0 00-.5.5v6a.5.5 0 001 0v-6a.5.5 0 00-.5-.5z" fill="currentColor"></path></svg>';

    var li = document.createElement('li');
    li.className = 'cart-drawer-item cart-item alora-free-item';
    li.setAttribute('role', 'row');
    li.setAttribute('data-alora-key', freeKey);
    li.innerHTML = [
      '<div class="cart-item__media" role="cell">',
        imgSrc ? '<img class="cart-item__image" src="' + imgSrc + '" alt="" loading="lazy" width="150" height="150">' : '',
      '</div>',
      '<div class="cart-drawer-item__right">',
        '<div class="cart-drawer-item__details-and-delete-btn">',
          '<div class="cart-item__details" role="cell">',
            '<h4 class="cart-item__name h4 break">' + titleText + '</h4>',
            '<div class="cart-item__discounted-prices cart-drawer-item__single-item-prices">',
              '<span>',
                '<s class="cart-item__old-price product-option text-color-text">' + fmt(perBottle) + '</s>',
                '<strong class="cart-item__final-price product-option text-color-accent-1">$0.00</strong>',
              '</span>',
              '<div class="cart-drawer__discounts list-unstyled" role="list" aria-label="Discount">',
                '<div class="badge">' + DISCOUNT_SVG + '<span>' + label + '</span></div>',
              '</div>',
            '</div>',
            '<p class="product-option">Free Express Shipping</p>',
          '</div>',
          '<div class="cart-drawer-item__cart-remove-button alora-free-remove">',
            '<button type="button" class="button button--tertiary" aria-label="Remove ' + titleText + '">' + TRASH_SVG + '</button>',
          '</div>',
        '</div>',
        '<div class="cart-drawer-item__quantity-and-prices cart-drawer-item__quantity-and-prices--has-props">',
          '<div class="cart-item__quantity">',
            '<div class="cart-item__quantity-wrapper">' + buildStepperHTML(freeQty) + '</div>',
          '</div>',
          '<div class="cart-item__totals right" role="cell">',
            '<div class="cart-item__price-wrapper">',
              '<div class="cart-item__discounted-prices">',
                '<s class="cart-item__old-price price--end compare-price color-foreground-text">' + fmt(oldTotal) + '</s>',
                '<span class="price--end regular-price accent-color-accent-1">$0.00</span>',
              '</div>',
              '<span class="cart-drawer-item__saving text-color-text"><strong>(You save ' + fmt(oldTotal) + ')</strong></span>',
            '</div>',
          '</div>',
        '</div>',
      '</div>'
    ].join('');

    list.insertBefore(li, realItem);
  }

  /* Apply on drawer open + whenever the drawer re-renders. */
  new MutationObserver(function (muts) {
    muts.forEach(function (m) {
      if (m.type === 'attributes' && m.attributeName === 'class') {
        var el = m.target;
        if (el.tagName && el.tagName.toLowerCase() === 'cart-drawer') {
          var isOpen = el.classList.contains('active') || el.classList.contains('is-open') || el.classList.contains('open');
          if (isOpen && window._aloraPendingCCId) { setTimeout(overrideCartDrawerPrices, 200); setTimeout(overrideCartDrawerPrices, 600); }
        }
      }
      if (m.type === 'childList') {
        var has = Array.from(m.addedNodes).some(function (n) { return n.nodeType === 1 && n.querySelector && n.querySelector('.price--end'); });
        if (has && window._aloraPendingCCId) setTimeout(overrideCartDrawerPrices, 100);
        if (window._aloraPendingCCId) overrideCartCount();
      }
    });
  }).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });

  /* Initial pass in case the drawer is already populated. */
  setTimeout(overrideCartDrawerPrices, 500);
  setTimeout(overrideCartDrawerPrices, 1200);
})();
}
</script>
