{% comment %}
  ──────────────────────────────────────────────────────────────
  snippets/ova-cc-redirect.liquid

  Redirects the Shopify cart/cart-drawer "Checkout" button to the
  CheckoutChamp checkout, building products=offerId.itemId:qty from the
  cart. Picks the subscription offer when the line item has a Shopify
  selling plan; otherwise uses the one-time offer.

  Install: add to theme.liquid (once, before </body>):
      {% render 'ova-cc-redirect' %}
{% endcomment %}

<script>
if (!window._ovaCcRedirectInit) {
window._ovaCcRedirectInit = true;
(function () {
  'use strict';

  var CC_BASE = 'https://secure.tryovalife.com/checkout';
  var SEP     = ';'; /* products separator: ';' for multiple; switch to ',' if your campaign expects commas */

  /* Shopify variant id -> { ot: one-time offer.item, sub: subscription offer.item } */
  var VARIANT_CC_MAP = {
    /* Berberine Blood Sugar Support Drops */
    '57761187332444': { ot: '1.7',  sub: '15.7'  },
    '57761187365212': { ot: '1.8',  sub: '16.8'  },
    '57761187397980': { ot: '1.9',  sub: '17.9'  },

    /* Complete 3-Phase Liver Support */
    '57761171964252': { ot: '2.10', sub: '18.10' },
    '57761171997020': { ot: '2.11', sub: '19.11' },
    '57761172029788': { ot: '2.12', sub: '20.12' },

    /* Complete Liver Detox & Insulin Reset */
    '57765138006364': { ot: '3.13', sub: '21.13' },
    '57761110884700': { ot: '3.14', sub: '22.14' },
    '57765146591580': { ot: '3.15', sub: '23.15' },

    /* Irish Seamoss Thyroid Hormone Regulator (A) */
    '57765170970972': { ot: '4.16', sub: '24.16' },
    '57765171003740': { ot: '4.17', sub: '25.17' },
    '57765171036508': { ot: '4.18', sub: '26.18' },

    /* Irish Seamoss Thyroid Hormone Regulator (B) */
    '57765168382300': { ot: '6.22', sub: '27.22' },
    '57765168415068': { ot: '6.23', sub: '28.23' },
    '57765168447836': { ot: '6.24', sub: '29.24' },

    /* Irish Saw Palmetto Complete Prostate Support */
    '57736719106396': { ot: '11.19', sub: '12.19' },
    '57736719139164': { ot: '11.20', sub: '13.20' },
    '57765157208412': { ot: '11.21', sub: '14.21' }
  };

  /* Checkout buttons to intercept (cart drawer + cart page). */
  var CHECKOUT_SELECTORS = [
    '#CartDrawer-Checkout',
    'button[name="checkout"]',
    'input[name="checkout"]',
    '.cart__checkout-button',
    '.cart__checkout',
    '#checkout'
  ].join(',');

  function cookie(name) {
    var m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]+)'));
    return m ? decodeURIComponent(m[1]) : '';
  }

  /* A line item is a subscription when Shopify attached a selling plan. */
  function isSubscription(item) {
    if (item.selling_plan_allocation) return true;
    if (item.selling_plan_id) return true;
    if (item.properties && (item.properties._selling_plan || item.properties.selling_plan)) return true;
    return false;
  }

  function redirectToCC(e) {
    if (e) { e.preventDefault(); e.stopImmediatePropagation(); }
    fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var parts = [];
        (cart.items || []).forEach(function (item) {
          var map = VARIANT_CC_MAP[String(item.variant_id)] || VARIANT_CC_MAP[String(item.id)];
          if (!map) return;
          var ccId = isSubscription(item) ? (map.sub || map.ot) : map.ot;
          if (ccId) parts.push(ccId + ':' + item.quantity);
        });
        if (!parts.length) { window.location.href = '/checkout'; return; } /* nothing mapped -> normal checkout */
        var url = CC_BASE + '?products=' + parts.join(SEP) + '&cartId=' + cookie('cart');
        var aff = cookie('affId');
        if (aff) url += '&affId=' + aff;
        window.location.href = url;
      })
      .catch(function () { window.location.href = '/checkout'; });
  }

  /* Capture phase so we beat the theme's own checkout handler. */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest(CHECKOUT_SELECTORS);
    if (!btn) return;
    redirectToCC(e);
  }, true);

  /* ──────────────────────────────────────────────────────────────
     Product page: when a variant in our map is currently selected and
     Shopify has disabled the ATC ("Sold out"), force-enable it, relabel
     it "BUY NOW", and on submit go straight to CheckoutChamp — bypassing
     Shopify cart + inventory.
     ────────────────────────────────────────────────────────────── */
  function variantIdFromForm(form) {
    var i = form.querySelector('input.product-variant-id, input[name="id"]');
    return i ? String(i.value || '') : '';
  }

  function isSubscriptionOnPage(form) {
    /* Selling-plan input inside or near the product form */
    var sp = form.querySelector('input[name="selling_plan"], input[name="selling_plan_id"], input[name="properties[__shopify_selling_plan]"]');
    if (sp && sp.value && sp.value !== '0') return true;
    /* Katching / common subscription toggles */
    var t = document.querySelector('[data-kaching-subscription]:checked, [data-kaching-sub]:checked, input[name*="selling_plan"]:checked');
    return !!t;
  }

  function redirectFromForm(form) {
    var vid = variantIdFromForm(form);
    var m = VARIANT_CC_MAP[vid];
    if (!m) return false;
    var ccId = isSubscriptionOnPage(form) ? (m.sub || m.ot) : m.ot;
    var url = CC_BASE + '?products=' + ccId + ':1&cartId=' + cookie('cart');
    var aff = cookie('affId');
    if (aff) url += '&affId=' + aff;
    window.location.href = url;
    return true;
  }

  function wireProductForm(form) {
    if (!form || form._ovaWired) return;
    var vid = variantIdFromForm(form);
    if (!VARIANT_CC_MAP[vid]) return; /* not one of ours */
    form._ovaWired = true;

    var btn = form.querySelector('button[type="submit"], button[name="add"]');
    if (btn) {
      if (btn.disabled || btn.getAttribute('data-unavailable') === 'true') {
        btn.disabled = false;
        btn.removeAttribute('disabled');
        btn.setAttribute('data-unavailable', 'false');
        var label = btn.querySelector('.main-atc__label__text, .product-form__submit-text, .button__label, span');
        if (label) label.textContent = 'BUY NOW';
      }
    }

    form.addEventListener('submit', function (e) {
      if (redirectFromForm(form)) { e.preventDefault(); e.stopImmediatePropagation(); }
    }, true);
  }

  function scanProductForms() {
    document.querySelectorAll('form[data-type="add-to-cart-form"], form[action="/cart/add"], form[action^="/cart/add"]').forEach(wireProductForm);
  }
  scanProductForms();
  new MutationObserver(scanProductForms).observe(document.body, { childList: true, subtree: true });
})();
}
</script>
